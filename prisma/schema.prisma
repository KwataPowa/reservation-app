// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reservations  Reservation[]
}

model Material {
  id            String    @id @default(cuid())
  name          String
  description   String?
  category      String?
  location      String?
  serialNumber  String?
  budget        String?   // Ex: "IdEx Flavien 2022"
  imageUrl      String?   // URL to image
  components    Json?     // List of sub-items [{ name, serialNumber }]
  notes         String?   // Known issues, maintenance notes
  status        Status    @default(AVAILABLE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reservations  Reservation[]
}

model Reservation {
  id             String    @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  purpose        String?
  location       String?
  status         ReservationStatus @default(PENDING)
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  materialId     String
  material       Material  @relation(fields: [materialId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  returnedAt     DateTime?
  returnNote     String?
  returnHasIssue Boolean   @default(false)
}

enum Role {
  USER
  ADMIN
}

enum Status {
  AVAILABLE
  MAINTENANCE
  UNAVAILABLE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  RETURNED
}
