generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MaterialStatus {
  AVAILABLE
  MAINTENANCE
  UNAVAILABLE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  role          Role          @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  reservations  Reservation[]

  @@map("users")
}

model Material {
  id           String         @id @default(cuid())
  name         String
  description  String?
  serialNumber String?        @unique
  location     String?
  category     String?
  status       MaterialStatus @default(AVAILABLE)
  imageUrl     String?        // Link to image if available
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  reservations Reservation[]

  @@map("materials")
}

model Reservation {
  id         String            @id @default(cuid())
  userId     String
  materialId String
  startDate  DateTime
  endDate    DateTime
  status     ReservationStatus @default(PENDING)
  purpose    String?           // Reason for reservation
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@map("reservations")
}
